# Copy to .env.local for local development.
# On Vercel, add each of these under Project → Settings → Environment Variables.
# .env.local is gitignored; this template is committed because it carries no secrets.

# ── Database (Neon / Supabase / any Postgres) ────────────────────────────────
# Neon gives you a pooled connection string. Keep `?sslmode=require`.
# Vercel's filesystem is read-only, so a database is the only store that works
# there — a JSON file or SQLite would silently reset on every deploy.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Gmail SMTP (sends the e-tickets) ────────────────────────────────────────
# GMAIL_USER is the full Gmail address.
# GMAIL_APP_PASSWORD is a 16-character App Password — NOT your Google password.
# It only appears after 2-Step Verification is switched on:
#   Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# ── Session signing ─────────────────────────────────────────────────────────
# Signs the httpOnly login cookie. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-32-bytes-of-random-hex

# ── Optional ────────────────────────────────────────────────────────────────
# Public origin, used to build absolute ticket links inside emails.
# On Vercel this is set for you; locally it defaults to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
