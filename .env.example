# Copy to .env.local for local development.
# On Vercel, add each of these under Project → Settings → Environment Variables.
# .env.local is gitignored; this template is committed because it carries no secrets.

# ── Database (Neon / Supabase / any Postgres) ────────────────────────────────
# Neon gives you a pooled connection string. Keep `?sslmode=require`.
# Vercel's filesystem is read-only, so a database is the only store that works
# there — a JSON file or SQLite would silently reset on every deploy.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Gmail SMTP (sends the e-tickets) ────────────────────────────────────────
# GMAIL_USER is the full Gmail address.
# GMAIL_APP_PASSWORD is a 16-character App Password — NOT your Google password.
# It only appears after 2-Step Verification is switched on:
#   Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# ── Demo sign-in ────────────────────────────────────────────────────────────
# A single email/password pair for demonstrating to a client without walking
# them through Google. Held here rather than in the database, so it can be
# changed from the Vercel dashboard without a deploy.
#
# Leave either one blank to switch demo login off — it fails closed, so a blank
# value never means "any password is accepted".
#
# This is not a real identity system: one account, no sign-up, no reset. Use it
# to get into the app; the tickets themselves are emailed to whatever address
# the buyer types at checkout, which can be a real inbox.
DEMO_EMAIL=demo@batamsmart.test
DEMO_PASSWORD=choose-something-for-the-demo

# ── Google Sign-In (optional, not linked from the sign-in page) ─────────────
# The OAuth routes remain in the codebase for a real identity if you want one,
# but the sign-in card uses DEMO_EMAIL / DEMO_PASSWORD instead. Register the
# callback URL below if you re-enable it, or Google returns
# redirect_uri_mismatch.
#   http://localhost:3000/api/auth/google/callback
#   https://<your-app>.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Session signing ─────────────────────────────────────────────────────────
# Signs the httpOnly login cookie. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-32-bytes-of-random-hex

# ── Optional ────────────────────────────────────────────────────────────────
# Public origin, used to build absolute ticket links inside emails.
# On Vercel this is set for you; locally it defaults to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
